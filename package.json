{
  "name": "local-to-echarts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first desktop tool: drop a CSV/Excel file, configure a chart, export PNG/PDF. Data never leaves your machine.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "jspdf": "^4.2.1",
    "vue": "^3.5.45",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.zengjianjin.local-to-echarts",
    "productName": "local-to-echarts",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
