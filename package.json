{
  "name": "local-to-echarts-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Local-first ECharts Studio: turn CSV/TSV/Excel into standard, reusable ECharts options in your browser or desktop app.",
  "license": "MIT",
  "author": "zengjianjin0920",
  "homepage": "https://zengjianjin.github.io/local-to-echart/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zengjianjin/local-to-echart.git"
  },
  "keywords": [
    "echarts",
    "visualization",
    "csv",
    "excel",
    "electron",
    "local-first",
    "data-visualization",
    "chart"
  ],
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "pnpm run build && electron-builder",
    "dist:win": "node scripts/dist-win.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "echarts": "^6.1.0",
    "jspdf": "^4.0.0",
    "lucide-vue-next": "^0.468.0",
    "papaparse": "^5.5.3",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^2.5.5",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/papaparse": "^5.3.15",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^5.4.20",
    "vue-tsc": "^2.2.0"
  },
  "build": {
    "appId": "com.localtoecharts.studio",
    "productName": "Local to ECharts Studio",
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh-TW"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
